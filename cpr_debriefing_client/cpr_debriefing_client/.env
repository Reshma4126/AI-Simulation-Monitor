# ==============================================================================
# .env.example — copy this to .env and fill in your keys
# The client should edit this file before running the app.
# ==============================================================================

# ── Ollama (local LLM — no key needed, runs inside Docker) ───────────────────
# Change this if you want a larger/different model.
# Smaller = faster on CPU:  qwen2.5:0.5b (default, ~400MB)
# Better quality:           qwen2.5:3b   (~2GB), mistral:7b (~4GB)
OLLAMA_MODEL=qwen2.5:0.5b

# ── HuggingFace (only needed for live AUDIO pipeline / speaker diarization) ──
# Leave blank if you only use JSON transcript upload.
# Get a free token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Anthropic Claude (optional — Ollama is used by default) ──────────────────
# Only needed if you switch the narrative engine to Claude.
ANTHROPIC_API_KEY=

# ── App Settings ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Security (leave blank to auto-generate on each start) ────────────────────
SECRET_KEY=
